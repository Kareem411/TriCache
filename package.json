{
  "name": "tricache",
  "version": "1.0.2",
  "description": "Three-tier Node.js cache: L1 smart RAM (adaptive LFU/LRU + Count-Min Sketch) → L1.5 NVMe disk spill → L2 Redis/Valkey. Includes AES-256-GCM at-rest encryption, WASM Bloom filter, Stale-While-Revalidate, and thundering-herd prevention.",
  "keywords": [
    "cache",
    "redis",
    "valkey",
    "lru",
    "lfu",
    "bloom-filter",
    "count-min-sketch",
    "swr",
    "stale-while-revalidate",
    "msgpack",
    "aes-256-gcm",
    "envelope-encryption",
    "nextjs",
    "express",
    "fastify",
    "hono",
    "edge",
    "cli",
    "nodejs"
  ],
  "license": "MIT",
  "author": "Kareem (https://github.com/Kareem411)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kareem411/TriCache.git"
  },
  "homepage": "https://github.com/Kareem411/TriCache#readme",
  "packageManager": "pnpm@11.22.0",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tricache": "./bin/tricache.js"
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./next": {
      "import": { "types": "./dist/next/index.d.ts", "default": "./dist/next/index.js" },
      "require": { "types": "./dist/next/index.d.cts", "default": "./dist/next/index.cjs" }
    },
    "./nestjs": {
      "import": { "types": "./dist/nestjs/index.d.ts", "default": "./dist/nestjs/index.js" },
      "require": { "types": "./dist/nestjs/index.d.cts", "default": "./dist/nestjs/index.cjs" }
    },
    "./prisma": {
      "import": { "types": "./dist/prisma/index.d.ts", "default": "./dist/prisma/index.js" },
      "require": { "types": "./dist/prisma/index.d.cts", "default": "./dist/prisma/index.cjs" }
    },
    "./drizzle": {
      "import": { "types": "./dist/drizzle/index.d.ts", "default": "./dist/drizzle/index.js" },
      "require": { "types": "./dist/drizzle/index.d.cts", "default": "./dist/drizzle/index.cjs" }
    },
    "./http": {
      "import": { "types": "./dist/http/index.d.ts", "default": "./dist/http/index.js" },
      "require": { "types": "./dist/http/index.d.cts", "default": "./dist/http/index.cjs" }
    },
    "./hono": {
      "import": { "types": "./dist/hono/index.d.ts", "default": "./dist/hono/index.js" },
      "require": { "types": "./dist/hono/index.d.cts", "default": "./dist/hono/index.cjs" }
    },
    "./dashboard": {
      "import": { "types": "./dist/dashboard/index.d.ts", "default": "./dist/dashboard/index.js" },
      "require": { "types": "./dist/dashboard/index.d.cts", "default": "./dist/dashboard/index.cjs" }
    },
    "./edge": {
      "edge-light": { "types": "./dist/edge/index.d.ts", "default": "./dist/edge/index.js" },
      "workerd": { "types": "./dist/edge/index.d.ts", "default": "./dist/edge/index.js" },
      "import": { "types": "./dist/edge/index.d.ts", "default": "./dist/edge/index.js" },
      "require": { "types": "./dist/edge/index.d.cts", "default": "./dist/edge/index.cjs" },
      "default": "./dist/edge/index.js"
    }
  },
  "files": [
    "bin",
    "dashboards",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/serialize-worker.ts src/next/index.ts src/nestjs/index.ts src/prisma/index.ts src/drizzle/index.ts src/http/index.ts src/hono/index.ts src/dashboard/index.ts src/edge/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/serialize-worker.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "bench": "node --expose-gc --max-old-space-size=8192 --import tsx/esm bench/benchmark.ts",
    "bench:roi": "tsx bench/cloud-roi-simulation.ts",
    "bench:compression": "tsx bench/compression.bench.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:start": "vitepress preview docs"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "hono": ">=3.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "lz4js": "^0.2.0",
    "msgpackr": "2.1.4",
    "zstd-codec": "^0.1.5"
  },
  "devDependencies": {
    "@nestjs/cache-manager": "12.0.5",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@types/node": "^26.6.2",
    "@opentelemetry/api": "^1.10.0",
    "cache-manager": "7.2.9",
    "hono": "^4.13.16",
    "keyv": "5.6.0",
    "markdown-it-mathjax3": "^4.3.2",
    "next": "16.4.6",
    "oxlint": "^1.85.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
